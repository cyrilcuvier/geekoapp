{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "redis": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": ["dockerhub", "appco"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["redis"],
        "properties": {
          "redis": {
            "required": ["source"],
            "properties": {
              "source": {"const": "appco"}
            }
          }
        }
      },
      "then": {
        "required": ["api"],
        "properties": {
          "api": {
            "required": ["redisSecret"],
            "properties": {
              "redisSecret": {
                "type": "object",
                "required": ["enabled", "name", "key"],
                "properties": {
                  "enabled": {"const": true},
                  "name": {"type": "string", "minLength": 1},
                  "key": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  ]
}
